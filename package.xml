<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_teleop_cpp</name>
  <version>0.1.0</version>
  <description>
    OpenArm VR teleoperation in one C++ ROS 2 node: Meta Quest UDP receiver,
    mink-equivalent MuJoCo IK (DAQP) and the dora-to-ros2 output stage.
  </description>
  <maintainer email="cmtan2314@users.noreply.github.com">cmtan2314</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_depend>nlohmann-json-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
